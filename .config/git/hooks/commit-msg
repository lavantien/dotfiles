#!/bin/bash
# Git commit-msg hook - Enforces Conventional Commits specification
# Validates: type(scope): subject format with a 100-char subject limit

COMMIT_MSG_FILE=$1
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Strip AI attribution trailers injected by AI coding harnesses. Runs
# before the merge skip so merge commits get the strip too
ATTRIBUTION_PATTERN='^(Co-Authored-By:.+(Claude|Anthropic|Copilot|Cursor|Gemini|Codeium|Windsurf|Cline|Aider)|Generated with .*(Claude|Copilot|Cursor))'

if printf '%s\n' "$COMMIT_MSG" | grep -qE "$ATTRIBUTION_PATTERN"; then
    COMMIT_MSG=$(printf '%s\n' "$COMMIT_MSG" | grep -vE "$ATTRIBUTION_PATTERN")
    printf '%s\n' "$COMMIT_MSG" > "$COMMIT_MSG_FILE"
    echo "Stripped AI attribution trailer from commit message."
fi

# Get the first line (subject). printf, not echo: the echo builtin eats a
# subject word that is exactly -n, -e, or a mix of those flag letters.
# The skip decision reads the subject only: a body line quoting
# "Merge ..." must not defeat the gate
SUBJECT=$(printf '%s\n' "$COMMIT_MSG" | head -n 1)

# Skip validation for merge and revert commits (they follow their own convention)
if printf '%s\n' "$SUBJECT" | grep -qE "^(Merge|Revert)"; then
    exit 0
fi

# Check for empty commit message
if [ -z "$SUBJECT" ]; then
    echo "ERROR: Commit message cannot be empty." >&2
    echo "Expected format: type(scope): description" >&2
    echo "Types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert, break, bump" >&2
    exit 1
fi

# Conventional Commits pattern: type(scope): description
# Type is required, scope is optional. Fully anchored so the subject
# length cap below actually fires, an unanchored .{1,N} matched any prefix.
MAX_SUBJECT_LENGTH=100

# Subject length in codepoints. LC_ALL=C pins tr to byte semantics, and
# UTF-8 continuation bytes (octal 200-277) extend a codepoint instead of
# starting one, so a C locale cannot over-reject multibyte subjects
SUBJECT_LENGTH=$(printf '%s' "$SUBJECT" | LC_ALL=C tr -d '\200-\277' | wc -c)
SUBJECT_LENGTH=$((SUBJECT_LENGTH))
CONVENTIONAL_PATTERN="^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert|break|bump)(\(.+\))?: .+$"

if ! printf '%s\n' "$SUBJECT" | grep -qE "$CONVENTIONAL_PATTERN"; then
    echo "ERROR: Commit message does not follow Conventional Commits format." >&2
    echo "" >&2
    echo "Expected format: type(scope): description" >&2
    echo "" >&2
    echo "Type (required): feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert, break, bump" >&2
    echo "Scope (optional): component or module in parentheses" >&2
    echo "Description: brief description (subject capped at $MAX_SUBJECT_LENGTH characters)" >&2
    echo "" >&2
    echo "Examples:" >&2
    echo "  feat(api): add user authentication endpoint" >&2
    echo "  fix(auth): resolve token expiration issue" >&2
    echo "  docs: update installation instructions" >&2
    echo "  test(auth): add unit tests for login flow" >&2
    echo "" >&2
    echo "Your subject: $SUBJECT" >&2
    echo "Subject length: $SUBJECT_LENGTH characters (max $MAX_SUBJECT_LENGTH)" >&2
    exit 1
fi

if [ "$SUBJECT_LENGTH" -gt "$MAX_SUBJECT_LENGTH" ]; then
    echo "ERROR: Subject exceeds $MAX_SUBJECT_LENGTH characters." >&2
    echo "Subject length: $SUBJECT_LENGTH characters (max $MAX_SUBJECT_LENGTH)" >&2
    echo "Your subject: $SUBJECT" >&2
    exit 1
fi

# Check for blank line after subject
# Get lines 2-3 (the line immediately after subject)
SECOND_LINE=$(printf '%s\n' "$COMMIT_MSG" | sed -n '2p')

if [ -n "$SECOND_LINE" ]; then
    echo "ERROR: Commit message must have a blank line between subject and body." >&2
    echo "" >&2
    echo "Subject: $SUBJECT" >&2
    echo "Second line: $SECOND_LINE" >&2
    echo "" >&2
    echo "Please add a blank line after the subject line." >&2
    exit 1
fi

exit 0
