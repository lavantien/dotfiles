#!/usr/bin/env bash

set -e

detect_os() {
	case "$(uname -s)" in
	Linux*) echo "linux" ;;
	Darwin*) echo "macos" ;;
	MINGW* | MSYS* | CYGWIN*) echo "windows" ;;
	*) echo "unknown" ;;
	esac
}

OS=$(detect_os)

if [ "$OS" = "windows" ]; then
	RED='\033[0;31m'
	GREEN='\033[0;32m'
	YELLOW='\033[1;33m'
	BLUE='\033[0;34m'
	NC='\033[0m'
else
	RED='\033[0;31m'
	GREEN='\033[0;32m'
	YELLOW='\033[1;33m'
	BLUE='\033[0;34m'
	NC='\033[0m'
fi

detect_projects() {
	local types=()
	[ -f "go.mod" ] && types+=("go")
	[ -f "package.json" ] && types+=("node")
	if [ -f "pyproject.toml" ] || [ -f "requirements.txt" ] ||
		[ -f "setup.py" ] || [ -f "poetry.lock" ]; then
		types+=("python")
	fi
	[ -n "$(find . -maxdepth 3 -name '*.cs' 2>/dev/null)" ] && types+=("csharp")
	[ -f "pom.xml" ] && types+=("java")
	[ -f "build.gradle" ] && types+=("java")
	[ -f "build.gradle.kts" ] && types+=("java")
	[ -f "build.sbt" ] && types+=("scala")
	[ -f "composer.json" ] && types+=("php")
	[ -f "Makefile" ] && ls *.c >/dev/null 2>&1 && types+=("c")
	[ -f "CMakeLists.txt" ] && types+=("cpp")
	[ -f "meson.build" ] && types+=("cpp")
	[ -d "frontend" ] && [ -f "frontend/package.json" ] && types+=("node-frontend")
	[ -d "backend" ] && [ -n "$(find backend -maxdepth 3 -name '*.cs' 2>/dev/null)" ] && types+=("csharp-backend")
	echo "${types[@]}"
}

command_exists() {
	command -v "$1" >/dev/null 2>&1
}

staged_files() {
	git diff --cached --name-only -z --diff-filter=ACMR | grep -zE "$1" || true
}

run_go_checks() {
	echo -e "\n${YELLOW}=== Go ===${NC}"
	local staged=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.go$' || true)
	[ -z "$staged" ] && return

	if command_exists goimports; then
		echo "Running goimports..."
		echo "$staged" | xargs goimports -w 2>/dev/null || true
	else
		echo "Running go fmt..."
		unformatted=$(gofmt -l $staged 2>/dev/null || true)
		[ -n "$unformatted" ] && echo "$unformatted" | xargs gofmt -w
	fi
	git add $staged 2>/dev/null || true

	if command_exists golangci-lint; then
		echo "Running golangci-lint..."
		golangci-lint run --no-config ./... 2>/dev/null || echo -e "${YELLOW}Lint warnings found.${NC}"
	fi

	echo "Running go vet..."
	go vet ./... 2>/dev/null || echo -e "${YELLOW}Go vet found issues.${NC}"
}

run_rust_checks() {
	local files=() f
	while IFS= read -r -d '' f; do files+=("$f"); done < <(staged_files '\.rs$')
	[ ${#files[@]} -eq 0 ] && return
	echo -e "\n${YELLOW}=== Rust ===${NC}"

	local roots=() d r dup
	for f in "${files[@]}"; do
		d=$(dirname "$f")
		while [ "$d" != "." ] && [ ! -f "$d/Cargo.toml" ]; do
			d=$(dirname "$d")
		done
		[ -f "$d/Cargo.toml" ] || continue
		dup=0
		for r in "${roots[@]}"; do [ "$r" = "$d" ] && dup=1; done
		[ $dup -eq 0 ] && roots+=("$d")
	done
	if [ ${#roots[@]} -eq 0 ]; then
		echo "no Cargo.toml above staged rust files, skipping cargo gates"
		return
	fi

	for d in "${roots[@]}"; do
		echo "Running cargo fmt in $d..."
		if ! (cd "$d" && cargo fmt --check) 2>/dev/null; then
			(cd "$d" && cargo fmt) 2>/dev/null || true
			git add "${files[@]}" 2>/dev/null || true
			echo -e "${YELLOW}Files formatted. Please review.${NC}"
		fi

		echo "Running cargo clippy in $d..."
		(cd "$d" && cargo clippy --quiet -- -D warnings) 2>/dev/null || echo -e "${YELLOW}Clippy warnings found.${NC}"

		echo "Running cargo check in $d..."
		if ! (cd "$d" && cargo check) 2>/dev/null; then
			echo -e "${RED}Cargo check failed ($d).${NC}"
			FAILED=1
		fi
	done
}

run_c_checks() {
	echo -e "\n${YELLOW}=== C/C++ ===${NC}"
	local staged=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(c|h|cpp|hpp|cc|cxx)$' || true)
	[ -z "$staged" ] && return

	if command_exists clang-format; then
		echo "Running clang-format..."
		for f in $staged; do
			[ -f "$f" ] && clang-format -i "$f" 2>/dev/null && git add "$f"
		done
	fi

	if command_exists clang-tidy && [ -f "compile_commands.json" ]; then
		echo "Running clang-tidy..."
		for f in $staged; do
			[ -f "$f" ] && clang-tidy "$f" 2>/dev/null || true
		done
	fi

	if command_exists cppcheck; then
		echo "Running cppcheck..."
		cppcheck --enable=all --error-exitcode=1 $staged 2>/dev/null || echo -e "${YELLOW}Cppcheck warnings.${NC}"
	fi
}

run_node_checks() {
	echo -e "\n${YELLOW}=== JavaScript/TypeScript ===${NC}"

	if npx --no-install prettier --version &>/dev/null 2>&1 || [ -f "node_modules/.bin/prettier" ]; then
		echo "Running Prettier..."
		if [ -f "node_modules/prettier-plugin-svelte/index.js" ] || [ -f "node_modules/prettier-plugin-svelte/dist/index.js" ]; then
			prettier_args="--plugin=prettier-plugin-svelte"
		else
			prettier_args=""
		fi
		if ! npx --no-install prettier --check . $prettier_args >/dev/null 2>&1; then
			npx --no-install prettier --write . $prettier_args 2>&1 | head -5
			git add . 2>/dev/null || true
			echo -e "${YELLOW}Files formatted with Prettier.${NC}"
		fi
	fi

	if npx --no-install eslint --version &>/dev/null 2>&1 || [ -f "node_modules/.bin/eslint" ]; then
		echo "Running ESLint..."
		if ! npx --no-install eslint . 2>&1 | head -20; then
			echo -e "${RED}ESLint errors found.${NC}"
			FAILED=1
		fi
	fi

	if grep -q '"check"' package.json 2>/dev/null; then
		echo "Running type check..."
		if ! npm run check --silent 2>/dev/null; then
			echo -e "${RED}Type check failed.${NC}"
			FAILED=1
		fi
	elif npx --no-install tsc --version &>/dev/null 2>&1 && [ -f "tsconfig.json" ]; then
		echo "Running tsc..."
		npx --no-install tsc --noEmit 2>/dev/null || echo -e "${YELLOW}TypeScript errors found.${NC}"
	fi
}

worktree_hashes() {
	local f out
	if out=$(git hash-object -- "$@" 2>/dev/null); then
		printf '%s\n' "$out"
		return
	fi
	for f in "$@"; do
		git hash-object -- "$f" 2>/dev/null || echo
	done
}

snapshot_rewrites() {
	REWRITE_CLEAN=()
	REWRITE_BEFORE=()
	local f d state id dirty=()
	while IFS= read -r -d '' d; do dirty+=("$d"); done < <(git diff --name-only -z)
	for f in "$@"; do
		state=clean
		for d in "${dirty[@]}"; do
			[ "$d" != "$f" ] || state=dirty
		done
		REWRITE_CLEAN+=("$state")
	done
	while IFS= read -r id; do REWRITE_BEFORE+=("$id"); done < <(worktree_hashes "$@")
}

stage_rewrites() {
	local tool=$1 after=() id f i=0
	shift
	while IFS= read -r id; do after+=("$id"); done < <(worktree_hashes "$@")
	for f in "$@"; do
		if [ "${after[$i]}" != "${REWRITE_BEFORE[$i]}" ]; then
			if [ "${REWRITE_CLEAN[$i]}" = clean ]; then
				if ! git --literal-pathspecs add -- "$f"; then
					echo -e "${RED}Could not stage $f after $tool rewrote it.${NC}"
					FAILED=1
				else
					echo "Staged $f, $tool rewrote it."
				fi
			else
				echo -e "${RED}$f holds unstaged edits and $tool rewrote it, review the file and stage it again.${NC}"
				FAILED=1
			fi
		fi
		i=$((i + 1))
	done
}

run_python_checks() {
	echo -e "\n${YELLOW}=== Python ===${NC}"
	local files=() f
	while IFS= read -r -d '' f; do files+=("$f"); done < <(staged_files '\.py$')
	[ ${#files[@]} -eq 0 ] && return

	if command_exists ruff; then
		echo "Running ruff check..."
		if ! ruff check --no-fix -- "${files[@]}" 2>/dev/null; then
			snapshot_rewrites "${files[@]}"
			if ! ruff check --fix -- "${files[@]}"; then
				echo -e "${RED}Ruff found errors in staged python files.${NC}"
				FAILED=1
			fi
			stage_rewrites "ruff check --fix" "${files[@]}"
		fi

		echo "Running ruff format..."
		snapshot_rewrites "${files[@]}"
		if ! ruff format -- "${files[@]}"; then
			echo -e "${RED}Ruff format failed on staged python files.${NC}"
			FAILED=1
		fi
		stage_rewrites "ruff format" "${files[@]}"
	fi

	if ! command_exists ruff; then
		if command_exists black; then
			echo "Running black..."
			snapshot_rewrites "${files[@]}"
			if ! black --check -- "${files[@]}" 2>/dev/null; then
				if ! black -- "${files[@]}"; then
					echo -e "${RED}Black failed on staged python files.${NC}"
					FAILED=1
				fi
				stage_rewrites black "${files[@]}"
			fi
		fi

		if command_exists isort; then
			echo "Running isort..."
			snapshot_rewrites "${files[@]}"
			if ! isort --check-only -- "${files[@]}" 2>/dev/null; then
				if ! isort -- "${files[@]}"; then
					echo -e "${RED}isort failed on staged python files.${NC}"
					FAILED=1
				fi
				stage_rewrites isort "${files[@]}"
			fi
		fi
	fi

	if command_exists mypy; then
		echo "Running mypy..."
		mypy -- "${files[@]}" 2>/dev/null || echo -e "${YELLOW}Type check warnings.${NC}"
	fi
}

run_csharp_checks() {
	echo -e "\n${YELLOW}=== C# ===${NC}"
	cd "$(git rev-parse --show-toplevel)"
	local staged=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(cs|csproj)$' || true)
	[ -z "$staged" ] && return

	if ! command_exists dotnet; then
		return
	fi

	local roots=$(printf '%s\n' "$staged" | while read -r f; do
		d=$(dirname "$f")
		while [ "$d" != "." ] && [ -z "$(ls "$d"/*.csproj 2>/dev/null)" ]; do
			d=$(dirname "$d")
		done
		echo "$d"
	done | sort -u)

	for d in $roots; do
		for p in "$d"/*.csproj; do
			[ -f "$p" ] || continue
			echo "check+build $p"
			dotnet format "$p" --verify-no-changes --include $staged >/dev/null 2>&1 || {
				echo -e "${RED}Format drift in staged files ($p).${NC}"
				FAILED=1
			}
			dotnet build "$p" -v q --nologo >/dev/null 2>&1 || {
				echo -e "${RED}Build failed: $p${NC}"
				FAILED=1
			}
		done
	done
}

run_java_checks() {
	echo -e "\n${YELLOW}=== Java ===${NC}"

	if [ -f "pom.xml" ] && grep -q "spotless" pom.xml 2>/dev/null; then
		echo "Running spotless check..."
		mvn spotless:check 2>/dev/null || {
			mvn spotless:apply 2>/dev/null
			git add . 2>/dev/null || true
		}
	fi

	if command_exists google-java-format; then
		echo "Running google-java-format..."
		google-java-format --replace 2>/dev/null || true
	fi

	if [ -f "pom.xml" ] && command_exists mvn; then
		echo "Running checkstyle..."
		mvn checkstyle:check 2>/dev/null || echo -e "${YELLOW}Checkstyle warnings.${NC}"
	fi
}

run_scala_checks() {
	echo -e "\n${YELLOW}=== Scala ===${NC}"

	if [ -f "build.sbt" ] && command_exists sbt; then
		echo "Running sbt compile..."
		sbt compile 2>/dev/null || echo -e "${YELLOW}Compilation warnings.${NC}"
	fi
}

run_php_checks() {
	echo -e "\n${YELLOW}=== PHP ===${NC}"
	local staged=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.php$' || true)
	[ -z "$staged" ] && return

	if [ -f "vendor/bin/pint" ]; then
		echo "Running Laravel Pint..."
		./vendor/bin/pint --test 2>/dev/null || {
			./vendor/bin/pint
			git add $staged 2>/dev/null || true
		}
	fi

	if [ -f "vendor/bin/php-cs-fixer" ]; then
		echo "Running php-cs-fixer..."
		./vendor/bin/php-cs-fixer fix --dry-run 2>/dev/null || {
			./vendor/bin/php-cs-fixer fix
			git add $staged 2>/dev/null || true
		}
	fi

	if [ -f "vendor/bin/phpstan" ]; then
		echo "Running PHPStan..."
		./vendor/bin/phpstan analyse --memory-limit=1G 2>/dev/null || echo -e "${YELLOW}PHPStan warnings.${NC}"
	fi

	if [ -f "vendor/bin/psalm" ]; then
		echo "Running Psalm..."
		./vendor/bin/psalm --show-info=false 2>/dev/null || echo -e "${YELLOW}Psalm warnings.${NC}"
	fi
}

run_shell_checks() {
	local files=() f out status
	while IFS= read -r -d '' f; do files+=("$f"); done < <(staged_files '\.(sh|bash)$')
	[ ${#files[@]} -eq 0 ] && return
	echo -e "\n${YELLOW}=== Shell ===${NC}"

	if command_exists shfmt; then
		echo "Running shfmt..."
		for f in "${files[@]}"; do
			shfmt -w "$f" 2>/dev/null && git add "$f"
		done
	fi

	if command_exists shellcheck; then
		echo "Running shellcheck..."
		status=0
		out=$(shellcheck --severity=error "${files[@]}" 2>&1) || status=$?
		if [ "$status" -ne 0 ]; then
			printf '%s\n' "$out" | head -40
			echo -e "${RED}shellcheck found errors in staged shell files.${NC}"
			FAILED=1
		fi
	fi
}

run_lua_checks() {
	local files=() f
	while IFS= read -r -d '' f; do files+=("$f"); done < <(staged_files '\.lua$')
	[ ${#files[@]} -eq 0 ] && return

	echo -e "\n${YELLOW}=== Lua ===${NC}"
	if command_exists stylua; then
		echo "Running stylua..."
		for f in "${files[@]}"; do
			stylua "$f" 2>/dev/null && git add "$f"
		done
	fi

	if command_exists selene; then
		echo "Running selene..."
		selene "${files[@]}" 2>&1 | head -30
	fi
}

run_scala_format_check() {
	local files=() f
	while IFS= read -r -d '' f; do files+=("$f"); done < <(staged_files '\.scala$')
	[ ${#files[@]} -eq 0 ] && return

	if ! command_exists scalafmt; then
		return
	fi
	echo -e "\n${YELLOW}=== Scala format ===${NC}"
	echo "Running scalafmt..."
	if scalafmt --non-interactive >/dev/null 2>&1; then
		for f in "${files[@]}"; do
			git add "$f" 2>/dev/null || true
		done
	else
		echo -e "${YELLOW}scalafmt failed, check .scalafmt.conf.${NC}"
	fi
}

run_php_pint_check() {
	local files=() f
	while IFS= read -r -d '' f; do files+=("$f"); done < <(staged_files '\.php$')
	[ ${#files[@]} -eq 0 ] && return
	[ -x "vendor/bin/pint" ] && return

	if ! command_exists pint; then
		return
	fi
	echo -e "\n${YELLOW}=== PHP ===${NC}"
	echo "Running pint..."
	for f in "${files[@]}"; do
		pint "$f" 2>/dev/null && git add "$f"
	done
}

run_powershell_checks() {
	local files=() out
	while IFS= read -r -d '' f; do files+=("$f"); done < <(staged_files '\.ps1$')
	[ ${#files[@]} -eq 0 ] && return
	if [ "$OS" != "windows" ]; then
		return
	fi
	if ! command_exists pwsh; then
		return
	fi

	if ! pwsh -NoProfile -Command 'exit [int](-not (Get-Module -ListAvailable PSScriptAnalyzer))' >/dev/null 2>&1; then
		return
	fi
	echo -e "\n${YELLOW}=== PowerShell ===${NC}"
	echo "Running PSScriptAnalyzer..."
	out=$(pwsh -NoProfile -Command '@(Invoke-ScriptAnalyzer -Path $args -Severity Error) | ForEach-Object { "{0}:{1}: {2}" -f $_.ScriptName, $_.Line, $_.Message }' "${files[@]}" 2>/dev/null) || true
	if [ -n "$out" ]; then
		printf '%s\n' "$out"
		echo -e "${YELLOW}PSScriptAnalyzer issues in staged PowerShell files.${NC}"
	fi
}

_pre_commit_main() {
	echo -e "${BLUE}Pre-commit checks...${NC}"

	FAILED=0
	PROJECT_ROOT=$(git rev-parse --show-toplevel)
	cd "$PROJECT_ROOT"

	if command_exists typos; then
		STAGED_SPELL=()
		while IFS= read -r -d '' f; do STAGED_SPELL+=("$f"); done < <(git diff --cached --name-only -z --diff-filter=ACMR)
		if [ ${#STAGED_SPELL[@]} -gt 0 ]; then
			echo -e "\n${YELLOW}=== Spell check ===${NC}"
			SPELL_STATUS=0
			SPELL_OUT=$(typos --force-exclude -- "${STAGED_SPELL[@]}" 2>&1) || SPELL_STATUS=$?
			if [ $SPELL_STATUS -ne 0 ]; then
				echo "$SPELL_OUT" | head -30
				if [ $SPELL_STATUS -eq 2 ]; then
					echo -e "${RED}Spelling errors found in staged files.${NC}"
				else
					echo -e "${RED}typos exited $SPELL_STATUS (64 = unreadable file, 1 = usage/config error).${NC}"
				fi
				FAILED=1
			fi
		fi
	fi

	PROJECTS=($(detect_projects))
	if [ ${#PROJECTS[@]} -eq 0 ]; then
		echo -e "${YELLOW}No recognized project type found.${NC}"
	fi

	for project in "${PROJECTS[@]}"; do
		case $project in
		go) run_go_checks ;;
		c) run_c_checks ;;
		cpp) run_c_checks ;;
		node | node-frontend)
			cd frontend 2>/dev/null || cd .
			run_node_checks
			cd "$PROJECT_ROOT"
			;;
		python) run_python_checks ;;
		csharp | csharp-backend)
			cd backend 2>/dev/null || cd .
			run_csharp_checks
			cd "$PROJECT_ROOT"
			;;
		java) run_java_checks ;;
		scala) run_scala_checks ;;
		php) run_php_checks ;;
		esac
	done

	run_rust_checks
	run_shell_checks
	run_lua_checks
	run_scala_format_check
	run_php_pint_check
	run_powershell_checks

	if [ $FAILED -eq 1 ]; then
		echo -e "\n${RED}Pre-commit checks failed. Fix issues or use --no-verify to bypass.${NC}"
		exit 1
	fi

	echo -e "${GREEN}All checks passed!${NC}"
	exit 0
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
	_pre_commit_main
fi
